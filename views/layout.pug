doctype html
html(lang="en")
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title #{title || 'Oyera Auto Service'}
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
    link(rel='stylesheet' href='/css/oyera.css')
    link(rel='stylesheet' href='/css/style.css')
    link(rel='stylesheet' href='/css/login.css')
    link(rel='stylesheet' href='/css/layout.css')
   
    block head
  body
    header
      .header-inner
        h1 Oyera Auto Service
        if session
          p Welcome #{session.username}
    nav
      a(href='/') Home
      a(href='/dashboard') service Records
      if user && (user.role === "Senior Technician" || user.role === "Admin")
        a(href='/dashboard') Dashboard
        a(href='/inventory/add-inventory') Inventory
        a(href='/stock/register') Register Stock
        a(href='/customers/register') Customers
        a(href='/vehicles/register') Vehicles
      if session
        a(href='/logout') Logout (#{user.fullName})
      else
        a(href='#' onclick='openLoginModal(); return false;') Login
        a(href='#' onclick='openSignupModal(); return false;') Signup
    main
      block content

    if !session
      .modal.fade.login-modal#loginModal(tabindex='-1' aria-labelledby='loginModalLabel' aria-hidden='true')
        .modal-dialog.modal-dialog-centered
          .modal-content
            .modal-header
              h5.modal-title#loginModalLabel System Login
              button.btn-close.btn-close-white(type='button' data-bs-dismiss='modal' aria-label='Close')
            .modal-body
              form#loginForm(action='/login' method='POST')
                .mb-3
                  label.form-label(for='username') Username
                  input#username.form-control(type='text' name='username' required='')
                .mb-3
                  label.form-label(for='password') Password
                  input#password.form-control(type='password' name='password' required='')
                .mb-3
                  label.form-label(for='loginRole') Select Role
                  select#loginRole.form-select(name='role' required='')
                    option(value='') Select your role
                    option(value='admin') Admin
                    option(value='senior') Senior Technician
                    option(value='technician') Technician
                .d-grid
                  button.btn.btn-primary(type='submit') Login

      .modal.fade.login-modal#signupModal(tabindex='-1' aria-labelledby='signupModalLabel' aria-hidden='true')
        .modal-dialog.modal-dialog-centered
          .modal-content
            .modal-header
              h5.modal-title#signupModalLabel User Registration
              button.btn-close.btn-close-white(type='button' data-bs-dismiss='modal' aria-label='Close')
            .modal-body
              form#signupForm(action='/signup' method='POST')
                .mb-3
                  label.form-label(for='signupUsername') Username
                  input#signupUsername.form-control(type='text' name='username' required='')
                .mb-3
                  label.form-label(for='signupPassword') Password
                  input#signupPassword.form-control(type='password' name='password' required='')
                .mb-3
                  label.form-label(for='identifier') Email or phone number
                  input#identifier.form-control(type='text' name='identifier' required='')
                .mb-3
                  label.form-label(for='role') Select Role
                  select#role.form-select(name='role' required='')
                    option(value='technician') Technician
                    option(value='senior') Senior Technician
                    option(value='admin') Admin
                .d-grid
                  button.btn.btn-primary(type='submit') Sign Up

    footer
      p © Oyera  Auto Service
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
    script(src='/js/script.js')
    block scripts
