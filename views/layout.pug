doctype html
html(lang="en")
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title #{title || 'Oyera Auto Service'}
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
    link(rel='stylesheet' href='/css/oyera.css')
    //link(rel='stylesheet' href='/css/style.css')
    link(rel='stylesheet' href='/css/login.css')
    link(rel='stylesheet' href='/css/layout.css')
   
    block head
  body
    header
      .header-inner
        img(src='/images/oyeralogo.png' alt='Oyera Logo' style='height: 40px; width: auto; margin-right: 15px; display: inline-block;')
        h1(style='display: inline-block;') Oyera Auto Service
        if user
          p Welcome #{user.fullname}
    nav
      if user
        a(href='/dashboard') Dashboard
        a(href='/inventory/add-inventory') Add Inventory Item
        a(href='/logout') Logout (#{user.fullname})
      else
        a(href='/') Home
        a(href='/login' ) Login
        a(href='/signup' ) Signup
    main
      block content

    footer
      p © Oyera  Auto Service
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
    script(src='/js/script.js')
    block scripts
