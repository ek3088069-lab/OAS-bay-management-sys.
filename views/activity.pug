doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Activity Log - Oyera Auto Service Bay
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
    link(rel='stylesheet' href='/css/oyera.css')
  body
    .container.py-5
      .d-flex.justify-content-between.align-items-center.mb-4
        div
          h1.mb-1 Activity Log
          p.text-muted.mb-0 Logged in as #{role} - #{session.username}
        a.btn.btn-outline-dark(href='/dashboard') Back to Dashboard

      .card.shadow-sm.border-0
        .card-body
          if logs && logs.length
            .table-responsive
              table.table.table-striped.align-middle
                thead
                  tr
                    th Username
                    th Role
                    th Action
                    th Details
                    th Date
                tbody
                  each log in logs
                    tr
                      td= log.username || 'System'
                      td= log.role || 'Unknown'
                      td= log.action || 'Unknown'
                      td= log.details || 'No details available'
                      td= new Date(log.createdAt).toLocaleString()
          else
            .alert.alert-info.mb-0 No activity has been recorded yet.
