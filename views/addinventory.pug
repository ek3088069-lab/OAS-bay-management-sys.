doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Register Stock - Oyera Auto Service Bay
    link(rel='stylesheet' href='/css/oyera.css')
    link(rel='stylesheet' href='/css/addinventory.css')

  body.inventory-page
    header(style='background: #f8f9fa; padding: 20px 0; border-bottom: 1px solid #dee2e6;')
      .container(style='display: flex; align-items: center; gap: 20px;')
        img(src='/images/oyeralogo.png' alt='Oyera Logo' style='height: 50px; width: auto;')
        h1(style='margin: 0;') Oyera Auto Service Bay
    main.inventory-content
      .inventory-form-card
        h1 Register New Stock
        p.form-intro Add spare parts, fluids, and other service stock to the inventory.

        form(action='/inventory/add-inventory' method='POST')
          .form-field
            label(for='itemName') Item Name
            input#itemName(type='text' name='ItemName' required)

          .form-field
            label(for='category') Category
            select#category(name='Category' required)
              option(value='' selected disabled) Select a category
              option(value='Engine Oil') Engine Oil
              option(value='Gear Oil') Gear Oil
              option(value='Brake Fluid') Brake Fluid
              option(value='Oil Filter') Oil Filter
              option(value='Brake Pads') Brake Pads
              option(value='Tyres') Tyres
              option(value='Grease') Grease

          .form-row
            .form-field
              label(for='quantity') Quantity
              input#quantity(type='number' name='Quantity' min='1' required)
            .form-field
              label(for='unitPrice') Unit Price (UGX)
              input#unitPrice(type='number' name='UnitPrice' min='5000' step='1000' required)

          .form-field
            label(for='supplier') Supplier
            input#supplier(type='text' name='Supplier' required)

          .form-field
            label(for='dateReceived') Date Received
            input#dateReceived(type='date' name='DateReceived' required)

          button(type='submit') Save Stock

        a.back-link(href='/inventory') ← Back to Inventory

    footer
      p © Oyera Auto Service
