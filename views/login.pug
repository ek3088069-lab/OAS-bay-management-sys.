doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Login
  link(rel='stylesheet' href='/css/login.css')
.login-box
  .logo-container(style='text-align: center; margin-bottom: 30px;')
    img(src='/images/oyeralogo.png' alt='Oyera Logo' style='height: 60px; width: auto;')
  h2 System Login
  form#loginForm(action='/login' method='POST')
    br
    label(for='identifier') Email or phone Number
    input#identifier(type='text' name='identifier' required='')
    br
    label(for='password') Password
    input#password(type='password' name='password' required='')
    br
    button(type='submit') Login
    a.back-link(href="/signup")
      span Not registered yet?
      span.link-action Sign up
//- script(src='/js/script.js')
