doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Technicians - Oyera Auto Service
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
    style.
      body {
        background: url('/images/oyerabackground.png') center/cover no-repeat fixed;
        color: #fff;
      }
      .panel {
        background: rgba(17, 24, 39, 0.8);
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 12px 30px rgba(0,0,0,0.2);
      }
      .table {
        color: #fff;
      }
      .table thead th {
        border-color: rgba(255,255,255,0.2);
        color: #f4b400;
      }
      .table tbody td {
        border-color: rgba(255,255,255,0.1);
      }
      .btn-back {
        margin-top: 1rem;
      }
  body
    .container.py-5
      .panel
        h2.mb-4 Technicians
        p.mb-4 Logged in as: #{role}

        table.table.table-striped.table-hover
          thead
            tr
              th Username
              th Role
          tbody
            each technician in technicians
              tr
                td= technician.username
                td= technician.role

        a.btn.btn-primary.btn-back(href='/dashboard') Back to Dashboard
