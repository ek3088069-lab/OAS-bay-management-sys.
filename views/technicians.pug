doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Technicians - Oyera Auto Service
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
    style.
      body {
        background: url('/images/oyerabackground.png') center/cover no-repeat fixed;
        color: #fff;
      }
      .panel {
        background: rgba(17, 24, 39, 0.8);
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 12px 30px rgba(0,0,0,0.2);
      }
      .table {
        color: #fff;
      }
      .table thead th {
        border-color: rgba(255,255,255,0.2);
        color: #f4b400;
      }
      .table tbody td {
        border-color: rgba(255,255,255,0.1);
      }
      .btn-back {
        margin-top: 1rem;
      }
      .page-title {
        color: #f4b400;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.45);
      }
  body
    header(style='background: rgba(17, 24, 39, 0.9); padding: 20px 0; border-bottom: 2px solid #f4b400;')
      .container.d-flex.align-items-center.gap-3
        img(src='/images/oyeralogo.png' alt='Oyera Logo' style='height: 50px; width: auto;')
        h1(style='margin: 0; color: #f4b400;') Oyera Auto Service Bay
    .container.py-5
      .panel
        h1.page-title.mb-4 Technicians
        p.mb-4 Logged in as: #{role}

        if technicians && technicians.length
          .table-responsive
            table.table.table-striped.table-hover
              thead
                tr
                  th Technician
                  th Role
                  th Contact
              tbody
                each technician in technicians
                  tr
                    td= technician.fullname
                    td= technician.role
                    td= technician.email || technician.phone || 'Not provided'
        else
          .alert.alert-info.mb-0 No technicians have been registered yet.

        a.btn.btn-primary.btn-back(href='/dashboard') Back to Dashboard
