extends layout

block head
  link(rel='stylesheet' href='/css/services.css')

block content
  .services-page
    .services-heading
      div
        p.services-eyebrow Oyera Auto Service Bay
        h1 Service catalogue
        p Choose one or more services for a vehicle. All prices are in Uganda shillings (UGX).
      .services-actions
        a.services-register(href='/services/register') Add service record
        a.services-back(href='/dashboard') Back to dashboard

    .services-list
      each service in services
        article.service-item
          .service-icon(aria-hidden='true')= service.icon
          .service-details
            p.service-category= service.category
            h2= service.name
            p.service-description= service.description
          .service-price
            span Price
            strong= service.price
