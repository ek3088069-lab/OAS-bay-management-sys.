doctype html
html(lang='en')

  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Oyera Auto Service Bay

    // Your existing CSS
    link(rel='stylesheet' href='/css/oyera.css')
    link(rel='stylesheet' href='/css/dashboard.css')


  body

    // ================= TOP BAR =================

    header.top-bar

      // Logo
      //- .logo
      //-   img(src='/images/oyera-logo.png' alt='Oyera Auto Service Bay')

      // User
      .user-info
        span.user-icon 👤
        span#userName= session.username || 'User'


    // ================= MAIN LAYOUT =================

    .dashboard-layout


      // ================= SIDEBAR =================

      aside.sidebar

        nav

          a.active(href='/dashboard')
            | 📈 Dashboard

          a(href='/services')
            | 🔧 Services

          a(href='/technicians')
            | 👨‍🔧 Technicians

          a(href='/inventory')
            | 📦 Inventory

          a(href='/reports')
            | 📊 Reports

          a(href='/settings')
            | ⚙️ Settings

          a(href='/activity')
            | 📜 Activity Log


      // ================= MAIN CONTENT =================

      main.main-content


        // Page Heading

        .page-heading

          div
            h1 OAS Bay Dashboard
            p Records &amp; Service Management Overview

          .welcome-message
            | 👋 Welcome back,
            strong#welcomeUser= session.username || 'User'
            | !


        // ================= STATISTICS =================

        section.stats-section

          .stats-grid

            // Today's Revenue

            .stat-box

              .stat-icon 💰

              div
                .stat-label Today's Revenue
                .stat-number#todayRevenue UGX 0


            // Available technicians

            .stat-box

              .stat-icon 👨‍🔧

              div
                .stat-label Available technicians
                .stat-number#activeJobs 0


        // ================= NEW SERVICE ENTRY =================

        section.service-entry

          h2 New Service Entry

          form#serviceForm

            // Service

            select(
              id='service'
              name='service'
            )
              option(value='') Select a service
              option(value='engine-oil') Engine Oil &amp; Filter
              option(value='brake') Brake Service
              option(value='gearbox') Gearbox Oil &amp; Filter
              option(value='alignment') Wheel Alignment
              option(value='balancing') Wheel Balancing
              option(value='greasing') Greasing


            // Technician

            input(
              type='text'
              id='technician'
              name='technician'
              placeholder='Assigned Technician'
            )


            // Submit

            button(type='submit') Register Job


        // ================= DASHBOARD CARDS =================

        section.dashboard-grid

          // Services

          .card

            .card-icon 🔧

            h3 Services

            p View and manage service records.

            a(href='/services') View Services


          // Technicians

          .card

            .card-icon 👨‍🔧

            h3 Technicians

            p Manage technician assignments and skills.

            a(href='/technicians') View Technicians


          // Inventory

          .card

            .card-icon 📦

            h3 Inventory

            p Manage spare parts and stock.

            a(href='/inventory') View Inventory


        // ================= QUICK ACTIONS =================

        section.quick-actions

          h2 Quick Actions

          .action-buttons

            a.action-btn(href='/inventory')
              | 📋 View Stock

            a.action-btn(href='/inventory/add-inventory')
              | 📦 Add Stock

            a.action-btn(href='/reports')
              | 📊 Generate Report

            a.action-btn.danger(href='/logout')
              | Logout


