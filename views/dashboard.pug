doctype html
html(lang='en')

  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Oyera Auto Service Bay

    // Your existing CSS
    link(rel='stylesheet' href='/css/oyera.css')
    link(rel='stylesheet' href='/css/dashboard.css')


  body

    // ================= MAIN LAYOUT =================

    .dashboard-layout

      // ================= MAIN CONTENT =================

      main.main-content


        // Page Heading

        .page-heading(style='display: block; background: rgba(18, 20, 25, 0.60); border: 1px solid rgba(255, 255, 255, 0.12); padding: 25px; border-radius: 10px; margin-bottom: 30px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);')

          .heading-top(style='display: flex; justify-content: space-between; align-items: flex-start; gap: 30px; margin-bottom: 20px;')
            .heading-logo-title(style='display: flex; align-items: center; gap: 20px; flex: 1;')
              img(src='/images/oyeralogo.png' alt='Oyera Auto Service Bay' style='height: 50px; width: auto; flex-shrink: 0;')
              div(style='color: white;')
                h1(style='margin: 0; color: #f4b400; font-size: 28px;')= role + ' Dashboard'
                p(style='margin: 8px 0 0 0; color: #e0e0e0; font-size: 14px;') Records &amp; Service Management Overview
            
            .heading-user-info(style='text-align: right; color: white;')
              div(style='display: flex; align-items: center; gap: 12px; justify-content: flex-end; margin-bottom: 10px;')
                span.user-icon(style='font-size: 28px;') 
                div
                  span#userName(style='font-weight: 700; display: block; color: #f4b400; font-size: 16px;')= session.username || 'User'
                  p(style='margin: 5px 0 0 0; color: #e0e0e0; font-size: 13px;') Logged in as: #{role}

          .welcome-message(style='color: white; font-size: 16px;')
            | Welcome back, 
            strong#welcomeUser(style='color: #f4b400;')= session.username || 'User'
            | !


      // ================= SIDEBAR =================

      aside.sidebar

        nav

          if permissions.showServices
            a(href='/services')
              | 🔧 Services

          if permissions.showTechnicians
            a(href='/technicians')
              | 👨‍🔧 Technicians

          if permissions.showInventory
            a(href='/inventory')
              | 📦 Inventory

          if permissions.showReports
            a(href='/reports')
              | 📊 Reports

          if permissions.showActivityLog
            a(href='/activity')
              | 📜 Activity Log


        // ================= STATISTICS =================

        section.stats-section

          .stats-grid

            // Today's Revenue

            .stat-box

              .stat-icon 💰

              div
                .stat-label Today's Revenue
                .stat-number#todayRevenue UGX 0


            // Available technicians

            .stat-box

              .stat-icon 👨‍🔧

              div
                .stat-label Available technicians
                .stat-number#activeJobs= activeTechnicians


        // ================= NEW SERVICE ENTRY =================

        section.service-entry

          h2 New Service Entry

          form#serviceForm(action='/services/register' method='GET')
            p Add a complete record with the customer, vehicle, service date, and technician.
            button(type='submit') Add service record


        // ================= DASHBOARD CARDS =================

        section.dashboard-grid

          // Services
          if permissions.showServices
            .card

              .card-icon 🔧

              h3 Services

              p View and manage service records.

              a(href='/services') View Services


          // Technicians
          if permissions.showTechnicians
            .card

              .card-icon 👨‍🔧

              h3 Technicians

              p Manage technician assignments and skills.

              a(href='/technicians') View Technicians


          // Inventory
          if permissions.showInventory
            .card

              .card-icon 📦

              h3 Inventory

              p Manage spare parts and stock.

              a(href='/inventory') View Inventory


        // ================= QUICK ACTIONS =================

        section.quick-actions

          h2 Quick Actions

          .action-buttons

            if permissions.showInventory
              a.action-btn(href='/inventory')
                | 📋 View Stock

              a.action-btn(href='/inventory/add-inventory')
                | 📦 Add Stock

            if permissions.showServiceRegistration
              a.action-btn(href='/services/register')
                |🔧 Add Service record
            a.action-btn.danger(href='/logout')
              | Logout

