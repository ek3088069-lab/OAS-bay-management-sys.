doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Register user
  link(rel='stylesheet' href='/css/login.css')
.login-box
  h2 user registration
  form#signupForm(action='/signup' method='POST')
    br
    label(for='fullname') Full name 
    input#fullname(type='text' name='fullname' required='')
    br
    label(for='identifier') Email or phone Number
    input#identifier(type='text' name='identifier' required='')
    br
    label(for='role') Select Role
    select#role(name='role' required='')
      option(value='') Select role ...
      option(value='Technician') Technician
      option(value='Senior Technician') Senior Technician
      option(value='Admin') Admin
    br
    label(for='password') Password
    input#password(type='password' name='password' required='')
    br
    button(type='submit') Sign Up
