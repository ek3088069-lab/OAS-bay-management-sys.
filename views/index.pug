doctype html
head
  meta(charset='UTF-8')
  title Oyera Auto Bay Service
  link(rel='stylesheet' href='../css/oyera.css')
  style.
    html {
      background-image: url('/images/oyerabackground.png');
      background-attachment: fixed;
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
    }
body
  header
    img(src='/images/oyeralogo.png' alt='Oyera Logo' style='height: 60px; width: auto; margin-right: 20px; display: inline-block; vertical-align: middle;')
    h1(style='display: inline-block; vertical-align: middle;') OYERA AUTO BAY SERVICE
    nav
      a(href='/signup') Sign Up
       a(href='/login') login
  section
    h2 Welcome to Oyera Auto Bay Service
    p
      | Your trusted partner for efficient vehicle servicing and maintenance.
      | We are committed to helping keep your vehicle in good condition while
      | providing reliable and professional service.
  footer
    p &copy; 2026 Oyera Auto Bay Service
