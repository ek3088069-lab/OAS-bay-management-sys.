doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='/css/customerRegistration.css')
  title Customer Registration - Oyera Auto
header
  .header-container
    h1.logo
      | Oyera
      br
      span Auto
nav.navbar.navbar-expand-lg.bg-body-tertiary
  .container-fluid
    a.navbar-brand(href='/') Home
    button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarSupportedContent' aria-controls='navbarSupportedContent' aria-expanded='false' aria-label='Toggle navigation')
      span.navbar-toggler-icon
    #navbarSupportedContent.collapse.navbar-collapse
      ul.navbar-nav.me-auto.mb-2.mb-lg-0
        if user
            li.nav-item
                a.nav-link(href='adminDashboard.html') Service Records
            if user.role === "Senior Technician" || user.role === "Admin"
                li.nav-item
                    a.nav-link(href='#') Dashboard
                li.nav-item
                    a.nav-link(href='#') Manage Inventory 
                li.nav-item
                    a.nav-link(href='#') Technicians    
                
            li.nav-item
                a.nav-link(href='/inventory/add-inventory') Add Inventory
            li.nav-item
                a.nav-link.active(aria-current='page' href='/logout') Logout ((#{user.fullName}))
        else        
            li.nav-item
                a.nav-link(href='/login') Login
            li.nav-item
                a.nav-link(href='/signup') Register
block content